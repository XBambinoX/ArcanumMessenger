# Same cert directory for both the dev Vite server and the production
# nginx container (docker-compose.prod.yml) - the browser never talks
# to the API directly either way, only to whichever of the two is
# fronting it. Swapping in a real certificate later (once there's a
# real domain) just means putting different files here, not changing
# any config.
# Linux: /home/<username>/.aspnet/https
# Windows: C:/Users/<username>/.aspnet/https
HTTPS_CERT_DIR=/home/<username>/.aspnet/https

# Use 'db' as the host when running local database with Docker Compose.
POSTGRES_HOST=db
POSTGRES_DB=arcanum
POSTGRES_USER=arcanum_user
POSTGRES_PASSWORD=your_postgres_password

# Works with any SMTP provider - just point these four at it, nothing
# else to change. SMTP_USERNAME is the full mailbox address; most
# providers require an app-specific password rather than the account's
# normal sign-in password once two-step verification is turned on.
# Sending as your own real mailbox on the provider's own servers keeps
# DKIM/DMARC aligned automatically, so no separate domain or relay
# service is needed. Examples:
#   Gmail:      smtp.gmail.com,      port 587
#   Outlook.com: smtp-mail.outlook.com, port 587
#   Yahoo:      smtp.mail.yahoo.com, port 587
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USERNAME=your_mailbox@example.com
SMTP_PASSWORD=your_app_password

ENCRYPTION_KEK=your_encryption_key
EMAIL_HASH_PEPPER=your_hash_pepper
PUBLIC_ID_HASH_PEPPER=your_hash_pepper

JWT_SECRET=your_jwt_secret

MINIO_ROOT_USER=your_minio_user
MINIO_ROOT_PASSWORD=your_minio_password